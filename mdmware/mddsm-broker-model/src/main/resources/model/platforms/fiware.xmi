<?xml version="1.0" encoding="ASCII"?>
<psk:Psk xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:psk="http://www.inf.ufg.br/broker/psk"
    platform="FIWARE">
  <components
      name="OrionContextBroker"
      address="orion.lab.fiware.org/">
    <comm/>
  </components>
  <resource
      name="SL1"
      uuid="www.abcstreetlight.com">
    <parameters
        attribute="deviceBatteryStatus"
        value="Connected"/>
    <parameters
        attribute="deviceModel">
      <composed
          attribute="brandName"
          value="abc"/>
      <composed
          attribute="modelName"
          value="SL1"/>
    </parameters>
    <parameters
        attribute="location">
      <composed
          attribute="lat"/>
      <composed
          attribute="long"/>
      <composed
          attribute="type"
          value="point"/>
    </parameters>
    <parameters
        attribute="powerRating"
        value="5"/>
    <parameters
        attribute="streetPoleNum"
        value="2"/>
    <parameters
        attribute="voltage"
        value="50"/>
    <capabilities
        name="powerConsumption"
        value="10"/>
    <capabilities
        name="powerFactor"
        value="0.7"
        function="ACTUATOR"/>
    <capabilities
        name="powerState"
        value="off"
        function="ACTUATOR"/>
    <capabilities
        name="status"
        value="ok"/>
  </resource>
  <resource
      name="Vehicle">
    <capabilities
        name="brandName"
        value="Mercedes"/>
  </resource>
  <resource
      name="Camera"/>
  <resource
      name="OffStreetParking">
    <capabilities
        name="availableSpotNumber"
        value="121"/>
    <capabilities
        name="reliability"
        value="0.7"/>
  </resource>
</psk:Psk>
