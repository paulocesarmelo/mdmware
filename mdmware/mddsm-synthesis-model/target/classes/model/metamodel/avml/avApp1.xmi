<?xml version="1.0" encoding="ASCII"?>
<avml:AVSchema
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:avml="http://www.inf.ufg.br/m4md/avml"
    xmlns:constraint="http://www.inf.ufg.br/m4md/constraint">
  <cs xsi:type="avml:AVControlSchema">
    <controllers
        kindInteraction="DISTRIBUTED"
        controllerID="controller1"/>
  </cs>
  <ds xsi:type="avml:AVDataSchema">
    <vehicles
        id="v1">
      <constraints
          xsi:type="constraint:EConstraintSpecificValue"
          name="velocity"
          value="50"/>
    </vehicles>
  </ds>
</avml:AVSchema>
